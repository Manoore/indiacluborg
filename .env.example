# Neon Postgres — pooled connection string from the Neon console (Connection Details).
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/heartwalk?sslmode=require"

# Admin login (single shared admin account — simple by design for this app's scale).
ADMIN_EMAIL="admin@teamindia.org"
ADMIN_PASSWORD="change-me"
# Any long random string — used to sign the admin session cookie.
ADMIN_SESSION_SECRET="change-me-too"

# WhatsApp (Meta Cloud API) — optional, confirmation messages no-op until these are set.
# See docs/WHATSAPP_SETUP.md for the Meta-side setup checklist.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="heart_confirmation"
WHATSAPP_TEMPLATE_LANG="en_US"
