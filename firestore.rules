rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Public-safe projection of participants — no email/phone/pledge/status.
    // Written only by the syncPublicHeartWall Cloud Function.
    match /heartWall/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Full participant records — email, phone, pledge, payment status.
    // Never readable by the public; only by authenticated admins.
    match /participants/{id} {
      allow read: if isAdmin();
      allow create: if true; // public registration form
      allow update, delete: if isAdmin();
    }

    match /communities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaigns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{id} {
      allow read: if isAdmin();
      allow write: if false; // manage via Firebase console / admin SDK only
    }
  }
}
